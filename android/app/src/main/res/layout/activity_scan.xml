<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B14">

    <!-- 相机预览控件 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 扫描遮罩与发光提示框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 请将摄像头对准考试二维码"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="扫码后自动打开并注入自动搜题引擎"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- 扫描框样式 -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_scan_frame">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#10B981"
                android:layout_gravity="center_vertical"/>
        </FrameLayout>

    </LinearLayout>

    <!-- 底部手动输入 URL 栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#120E1C26"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A2035"
            android:hint="或在此直接粘贴考试网址 (如 http://...)"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOpenUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#4F46E5"
            android:text="🚀 直接进入答题网页"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
